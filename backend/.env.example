# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=4001
# Comma-separated list of origins allowed to call this API / connect via socket
CORS_ORIGIN=http://localhost:5180

# ---------------------------------------------------------------------------
# Auth — hardcoded technical-team accounts, seeded into MongoDB from
# src/auth/users.js (see scripts/migrate-users-to-mongo.js). Generate this
# secret yourself, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET=

# ---------------------------------------------------------------------------
# MongoDB Atlas — shared ticket + user store, so state is consistent across
# every device/login. Create a free cluster at https://cloud.mongodb.com and
# paste its connection string here.
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
MONGODB_DB=zoho_tech_dashboard

# ---------------------------------------------------------------------------
# Zoho Desk — OAuth (Server-based Application / Self Client in the Zoho API
# Console). See README.md for how to obtain a refresh token.
# ---------------------------------------------------------------------------
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.com
ZOHO_API_BASE=https://desk.zoho.com/api/v1
ZOHO_ORG_ID=
ZOHO_PORTAL_URL=https://support.example.com/agent/yourportal

ZOHO_DEPARTMENT_IDS=

# ---------------------------------------------------------------------------
# Polling — how often the backend refreshes tickets from Zoho. Every tick
# only re-fetches raw ticket fields (status, thread count, etc.), no AI
# involved, so this can safely be low (seconds) without cost concerns —
# just be mindful of Zoho's own API rate limits at very high frequency.
# ---------------------------------------------------------------------------
POLL_INTERVAL_MS=30000
TICKETS_SCAN_LIMIT=100
RECENT_WAITING_DAYS=5
